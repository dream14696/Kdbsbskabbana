local isInvincible = false
local isDraggingSlider = false
local minSize = Vector3.new(0.5, 0.5, 0.5)
local maxSize = rootPart.Size

RunService.RenderStepped:Connect(function()
	if not rootPart or not hitbox then return end
	if isInvincible then
		hitbox.CFrame = rootPart.CFrame + (rootPart.CFrame.LookVector * 3000)
	else
		hitbox.CFrame = rootPart.CFrame
	end
end)

toggleButton.MouseButton1Click:Connect(function()
	isInvincible = not isInvincible
	if isInvincible then
		toggleBackground.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
		toggleButton:TweenPosition(UDim2.new(1, -22, 0.5, -10), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
	else
		toggleBackground.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
		toggleButton:TweenPosition(UDim2.new(0, 2, 0.5, -10), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
	end
end)

local function UpdateSlider(input)
	local sliderPos = sliderFrame.AbsolutePosition.X
	local sliderLen = sliderFrame.AbsoluteSize.X
	local mouseX = input.Position.X
	local percentage = math.clamp((mouseX - sliderPos) / sliderLen, 0, 1)
	sliderButton.Position = UDim2.new(percentage, -8, 0.5, -8)
	local newSize = minSize:Lerp(maxSize, percentage)
	if hitbox then
		hitbox.Size = newSize
	end
end

sliderButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingSlider = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingSlider = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		UpdateSlider(input)
	end
end)

local equippedEmotes = {}
pcall(function()
	local desc = humanoid:GetAppliedDescription()
	local emotes = desc:GetEmotes()
	for name, idList in pairs(emotes) do
		if #idList > 0 then
			table.insert(equippedEmotes, {name = name, id = idList[1]})
		end
	end
end)

if #equippedEmotes == 0 then
	equippedEmotes = {
		{name = "Baile Chistoso", id = 507771019},
		{name = "Saludo", id = 507770677},
		{name = "Aplaudir", id = 507770239},
		{name = "Alegría", id = 507770453},
		{name = "Burla", id = 507770950}
	}
end

local currentTrack = nil
local function playEmote(id)
	if currentTrack then
		currentTrack:Stop()
	end
	local success, err = pcall(function()
		currentTrack = humanoid:PlayEmoteAndGet関節Track and humanoid:PlayEmoteAndGetTrack(tostring(id)) or nil
	end)
	if not success or not currentTrack then
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(id)
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
		currentTrack = animator:LoadAnimation(anim)
		currentTrack:Play()
	end
end

local function updateEmoteList(filter)
	for _, child in ipairs(scrollingFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local count = 0
	for _, emote in ipairs(equippedEmotes) do
		if filter == "" or string.find(string.lower(emote.name), string.lower(filter)) then
			count = count + 1
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -10, 0, 36)
			btn.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
			btn.BorderSizePixel = 0
			btn.Text = "  " .. emote.name
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.TextSize = 14
			btn.Font = Enum.Font.SourceSansSemibold
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.Parent = scrollingFrame

			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 6)
			btnCorner.Parent = btn

			btn.MouseButton1Click:Connect(function()
				playEmote(emote.id)
			end)
		end
	end
	scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, count * 42)
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	updateEmoteList(searchBox.Text)
end)

